from typing import TypedDict

from langgraph.graph import (
    StateGraph,
    START,
    END
)

class State(TypedDict):

    question:str
    answer:str
    count:int


# Node1

def node1(state):
    print("Node1 실행")

    return {
        "count":
        state["count"] + 1
    }



# Node2

def node2(state):

    print("Node2 실행")

    return {
        "count":
        state["count"] + 1
    }



# Node3

def node3(state):
    print("Node3 실행")

    return {
        "answer":
        "처리 완료",

        "count":
        state["count"] + 1

    }

builder = StateGraph(State)

builder.add_node(
    "node1",
    node1
)

builder.add_node(
    "node2",
    node2
)

builder.add_node(
    "node3",
    node3
)


builder.add_edge(
    START,
    "node1"
)

builder.add_edge(
    "node1",
    "node2"
)

builder.add_edge(
    "node2",
    "node3"
)


builder.add_edge(
    "node3",
    END
)



graph = builder.compile()



result = graph.invoke(

    {
        "question":
        "State란?",

        "answer":
        "",

        "count":
        0
    }

)


print(result)

########### state 전달 #################

from typing import TypedDict

from langgraph.graph import (
    StateGraph,
    START,
    END
)


class State(TypedDict):
    question:str
    context:str
    answer:str

# 검색 Node

def search_node(state):

    print(
        "검색:",
        state["question"]
    )

    return {
        "context":
        "LangGraph는 LLM Workflow Framework"
    }




# 답변 Node

def answer_node(state):
    print(
        "전달받은 Context"
    )


    print(
        state["context"]
    )


    return {
        "answer":
        f"{state['question']} : {state['context']}"
    }

builder = StateGraph(State)


builder.add_node(
    "search",
    search_node
)


builder.add_node(
    "answer",
    answer_node
)



builder.add_edge(
    START,
    "search"
)


builder.add_edge(
    "search",
    "answer"
)


builder.add_edge(
    "answer",
    END
)

graph = builder.compile()

result = graph.invoke(
    {
        "question":
        "LangGraph란?",

        "context":
        "",

        "answer":
        ""
    }
)


print("\n최종 결과")
print(result)

# graph.invoke()의 결과는 최종 State입니다.

