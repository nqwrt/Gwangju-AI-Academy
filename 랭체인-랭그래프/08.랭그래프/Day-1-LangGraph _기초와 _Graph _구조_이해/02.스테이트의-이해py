### Node에서 State 수정하기=======================================

from typing import TypedDict

from langgraph.graph import (
    StateGraph,
    START,
    END
)

# ----------------------
# State
# ----------------------
class State(TypedDict):
    question:str
    answer:str
    count:int
# ----------------------
# Node
# ----------------------
def question_node(state:State):

    print("현재 State")
    print(state)

    return {
        "answer":
        "LangGraph는 Graph 기반 Agent Framework입니다",
        "count": 1
    }

# ----------------------
# Graph 생성
# ----------------------

builder = StateGraph(State)


builder.add_node(
    "question",
    question_node
)


builder.add_edge(
    START,
    "question"
)


builder.add_edge(
    "question",
    END
)

graph = builder.compile()

# 실행
result = graph.invoke(
    {
        "question":
        "LangGraph란?",
        "answer":
        "",
        "count":
        0
    }
)

print("\n최종 State")
print(result)

